# Radar de Vida — WhatsApp Webhook v0.1

# Servidor local
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Token de verificação escolhido por você.
# Deve ser exatamente igual ao campo "Verify token" configurado no painel da Meta.
VERIFY_TOKEN=radar_de_vida_teste_123

# OpenAI
# Para teste sem IA, deixe vazio. O servidor usará heurística local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# WhatsApp Cloud API / Meta
# Token de acesso temporário ou permanente da Meta
WHATSAPP_TOKEN=

# Phone Number ID do número do WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=

# Versão da Graph API
WHATSAPP_GRAPH_VERSION=v23.0

# Opcional: App Secret da Meta para validar X-Hub-Signature-256.
# Em produção, configure.
META_APP_SECRET=

# Controle de resposta automática
SEND_WHATSAPP_CONFIRMATION=true

# Arquivo local de banco JSON
DB_FILE=./data/radar-db.json
